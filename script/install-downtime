#!/bin/sh
# Called by the regular Kalamar image build while git/cpm are still available.
set -eu
case "${WITH_DOWNTIME_CALENDAR:-1}" in
  0) printf '{"enabled":false}\n' > /kalamar/downtime-build.json; exit 0 ;;
  1) ;;
  *) echo 'WITH_DOWNTIME_CALENDAR must be 0 or 1' >&2; exit 2 ;;
esac
calendar_ref=${DOWNTIME_CALENDAR_REF:?Set a pinned full commit SHA}
case "$calendar_ref" in *[!0-9a-f]*|'') echo 'Calendar ref must be a full lowercase commit SHA' >&2; exit 2 ;; esac
[ "${#calendar_ref}" -eq 40 ] || { echo 'Calendar ref must be a full commit SHA' >&2; exit 2; }
calendar_source=$(mktemp -d /tmp/kalamar-calendar.XXXXXX)
trap 'rm -rf "$calendar_source"' EXIT HUP INT TERM
git init -q "$calendar_source"
git -C "$calendar_source" remote add origin "${DOWNTIME_CALENDAR_REPOSITORY:?Set the source repository}"
git -C "$calendar_source" fetch --depth=1 origin "$calendar_ref"
git -C "$calendar_source" checkout -q --detach FETCH_HEAD
[ "$(git -C "$calendar_source" rev-parse HEAD)" = "$calendar_ref" ]
cpm install --test -g "$calendar_source"
perl -MMojolicious::Plugin::DowntimeCalendar -e 'Mojolicious::Plugin::DowntimeCalendar->VERSION("0.02")'
printf '{"enabled":true,"ref":"%s"}\n' "$calendar_ref" > /kalamar/downtime-build.json
